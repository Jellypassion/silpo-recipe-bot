# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Silpo MCP server (official, per hackathon rules — do not change)
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# Public HTTPS base URL of THIS server, used as the OAuth redirect target.
# Locally, run a tunnel (e.g. `npx ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`)
# and put its https URL here, e.g. https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=

PORT=3000

# Claude model used by both agents
CLAUDE_MODEL=claude-opus-5

# Where OAuth tokens / client registration are persisted (server-side only)
DATA_DIR=./data
